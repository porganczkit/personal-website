# Tibor AI Avatar — environment variables
#
# 1. Copy this file to .env.local (which is gitignored — your key stays private)
# 2. Paste your Anthropic API key below
# 3. Restart the dev server
#
# Get a key at https://console.mistral.ai → API Keys
# Powers the chatbot replies AND voice input (Voxtral transcription).
MISTRAL_API_KEY=...

# ElevenLabs — voice OUT (the avatar speaking in Tibor's cloned voice).
# Optional: if unset, the avatar falls back to the browser's built-in voice.
# Key:      https://elevenlabs.io → Profile → API Keys
# Voice ID: https://elevenlabs.io → Voices → your cloned voice → "ID"
ELEVENLABS_API_KEY=...
ELEVENLABS_VOICE_ID=...
